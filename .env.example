# ---------------------------------------------------------------------------
# Copy to .env and adjust. docker compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=shwobiz
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=shwobiz

# Used by the app container. Host `db` is the compose service name.
DATABASE_URL=postgres://shwobiz:change-me-before-deploying@db:5432/shwobiz

# For running the server outside docker against the compose database,
# publish port 5432 in docker-compose.yml and use:
# DATABASE_URL=postgres://shwobiz:change-me-before-deploying@localhost:5432/shwobiz

# --- App ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Where uploaded images/videos are written. Backed by the `media-data` volume.
# Ignored when S3_BUCKET is set.
MEDIA_DIR=/data/media

# Largest single upload accepted, in megabytes.
MAX_UPLOAD_MB=512

# --- Object storage (optional) --------------------------------------------
# Setting S3_BUCKET moves uploads off the local volume and into an S3 bucket;
# the cluster deployment uses MinIO this way. Leave it empty for a plain
# `docker compose` install, which is happier with a directory.
#
# The other three are then required, and startup fails if one is missing —
# a pod that silently wrote uploads into its own container would lose every
# one of them at the next rollout.
#S3_ENDPOINT=http://minio.minio.svc:9000
#S3_BUCKET=sign
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# --- Jira Cloud -----------------------------------------------------------
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# These may also be set from the control panel, but env wins and is preferred:
# the panel has no authentication, so anything stored there is writable by
# anyone who can reach it.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# How long a Jira response is reused before refetching, in seconds.
JIRA_CACHE_TTL_SECONDS=120
