# ---------------------------------------------------------------------------
# Every value here is OPTIONAL. `docker compose up -d` works on a fresh clone
# with no .env at all — this file is for when you want to change something.
#
# Copy to .env and uncomment what you need; compose reads .env automatically.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# Defaults: user `shwobiz`, password `local-dev-only`, database `shwobiz`.
# The database publishes no port, so these never leave the compose network.
# Override the password and DATABASE_URL follows it automatically.
#POSTGRES_USER=shwobiz
#POSTGRES_PASSWORD=local-dev-only
#POSTGRES_DB=shwobiz

# Set this only to point the app at a database other than the compose one.
# Host `db` is the compose service name.
#DATABASE_URL=postgres://shwobiz:local-dev-only@db:5432/shwobiz

# Running the server on the host instead (`npm run dev`)? Uncomment the
# `ports` block on the `db` service in docker-compose.yml, then use:
#DATABASE_URL=postgres://shwobiz:local-dev-only@localhost:5432/shwobiz

# --- App ------------------------------------------------------------------
#PORT=3000
#HOST=0.0.0.0
#LOG_LEVEL=info

# Where uploaded images/videos are written. Backed by the `media-data` volume.
# Ignored when S3_BUCKET is set.
#MEDIA_DIR=/data/media

# Largest single upload accepted, in megabytes. Default 512.
#MAX_UPLOAD_MB=512

# --- Object storage (optional) --------------------------------------------
# Setting S3_BUCKET moves uploads off the local volume and into an S3 bucket;
# the cluster deployment uses MinIO this way. Leave it empty for a plain
# `docker compose` install, which is happier with a directory.
#
# The other three are then required, and startup fails if one is missing —
# a pod that silently wrote uploads into its own container would lose every
# one of them at the next rollout.
#S3_ENDPOINT=http://minio.minio.svc:9000
#S3_BUCKET=sign
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# --- Jira Cloud -----------------------------------------------------------
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# These may also be set from the control panel, but env wins and is preferred:
# the panel has no authentication, so anything stored there is writable by
# anyone who can reach it.
# Leave these commented unless you are using Jira slides — set, they are read
# at startup, and a half-filled set is a slide that draws an error badge.
#JIRA_BASE_URL=https://your-org.atlassian.net
#JIRA_EMAIL=you@example.com
#JIRA_API_TOKEN=

# How long a Jira response is reused before refetching, in seconds. Default 120.
#JIRA_CACHE_TTL_SECONDS=120
