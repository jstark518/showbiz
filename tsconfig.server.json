{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "composite": true
  },
  // The `plugins` glob picks up each plugin's `shared.ts` and its `server/`
  // half, and stops at the extension: every browser-only file under `plugins/`
  // is either `.tsx` or inside a `web/` folder, and both are kept out. That is
  // what stops React and the DOM lib leaking into the server project.
  "include": ["server/src/**/*.ts", "shared/**/*.ts", "plugins/**/*.ts"],
  "exclude": ["plugins/**/web/**"]
}
